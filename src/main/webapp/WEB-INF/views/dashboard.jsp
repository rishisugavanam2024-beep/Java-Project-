<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.resolvebid.web.Html,com.resolvebid.model.*" %>
<% UserAccount user=(UserAccount)request.getAttribute("user"); List<ServiceRequest> requests=(List<ServiceRequest>)request.getAttribute("requests"); Map<Long,List<Proposal>> proposals=(Map<Long,List<Proposal>>)request.getAttribute("proposals"); DashboardStats stats=(DashboardStats)request.getAttribute("stats"); String csrf=(String)request.getAttribute("csrf"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Workspace · ResolveBid</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="shell"><aside class="sidebar"><div class="brand">ResolveBid</div><div class="muted">Problems meet solutions</div><nav class="nav"><a href="#overview">Overview</a><a href="#work">Marketplace</a><a href="#new">New work</a><a href="${pageContext.request.contextPath}/api/requests">JSON API</a></nav><div class="account"><strong><%=Html.escape(user.displayName())%></strong><br><span class="role"><%=Html.escape(user.role())%></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<%=Html.escape(csrf)%>"><button class="ghost" type="submit">Sign out</button></form></div></aside>
<main class="main"><header class="topbar"><strong>Service marketplace workspace</strong><span class="status">● System online</span></header><div class="content"><section class="hero" id="overview"><div><div class="eyebrow"><%=Html.escape(user.role())%> workspace</div><h1>Good work starts with clarity.</h1><p>Track problems, compare transparent proposals, and turn the best decision into a confirmed booking.</p></div></section>
<% if(request.getAttribute("flashMessage")!=null){ %><div class="alert <%=Html.escape(request.getAttribute("flashKind"))%>" role="status"><%=Html.escape(request.getAttribute("flashMessage"))%></div><% } %>
<section class="metrics"><div class="metric"><span>Open requests</span><strong><%=stats.openRequests()%></strong></div><div class="metric"><span>Provider proposals</span><strong><%=stats.proposals()%></strong></div><div class="metric"><span>Bookings</span><strong><%=stats.bookings()%></strong></div><div class="metric"><span>Completed</span><strong><%=stats.completed()%></strong></div></section>
<div class="grid"><div><section class="card" id="work"><h2><%=user.role()==Role.CUSTOMER?"Your requests":"Open marketplace requests"%></h2><% if(requests.isEmpty()){ %><div class="empty">No requests to show yet.</div><% } for(ServiceRequest r:requests){ %><article class="request"><div class="request-head"><div><h3><%=Html.escape(r.category())%></h3><div class="meta">Request #<%=r.id()%> · <%=Html.escape(r.urgency())%> · ₹<%=Html.escape(r.budget())%></div></div><span class="badge"><%=Html.escape(r.status())%></span></div><p><%=Html.escape(r.description())%></p>
<% if(user.role()==Role.PROVIDER || user.role()==Role.ADMIN){ %><form method="post" action="${pageContext.request.contextPath}/app/action/proposal"><input type="hidden" name="csrf" value="<%=Html.escape(csrf)%>"><input type="hidden" name="requestId" value="<%=r.id()%>"><div class="field"><label>Diagnosis and scope</label><textarea name="diagnosis" required minlength="12" placeholder="Explain the likely cause and work included"></textarea></div><div class="two"><div class="field"><label>Price (INR)</label><input type="number" min="1" step="0.01" name="price" required></div><div class="field"><label>ETA (days)</label><input type="number" min="1" name="etaDays" required></div></div><div class="field"><label>Warranty (days)</label><input type="number" min="1" name="warrantyDays" required></div><button>Submit proposal</button></form><% } %>
<% for(Proposal p:proposals.getOrDefault(r.id(),List.of())){ %><div class="proposal"><div class="proposal-grid"><div><strong><%=Html.escape(p.providerName())%></strong><p><%=Html.escape(p.diagnosis())%></p><span class="meta">₹<%=Html.escape(p.price())%> · <%=p.etaDays()%> days · <%=p.warrantyDays()%>-day warranty</span></div><span class="badge"><%=Html.escape(p.status())%></span></div><% if((user.role()==Role.CUSTOMER||user.role()==Role.ADMIN)&&r.status()==RequestStatus.OPEN){ %><form method="post" action="${pageContext.request.contextPath}/app/action/accept"><input type="hidden" name="csrf" value="<%=Html.escape(csrf)%>"><input type="hidden" name="requestId" value="<%=r.id()%>"><input type="hidden" name="proposalId" value="<%=p.id()%>"><div><label>Service date</label><input type="date" name="date" required></div><button>Accept & book</button></form><% } %></div><% } %></article><% } %></section></div>
<aside><% if(user.role()==Role.CUSTOMER || user.role()==Role.ADMIN){ %><section class="card" id="new"><h2>Post a new problem</h2><form method="post" action="${pageContext.request.contextPath}/app/action/request"><input type="hidden" name="csrf" value="<%=Html.escape(csrf)%>"><div class="field"><label>Category</label><select name="category" required><% for(String c:(String[])request.getAttribute("categories")){ %><option><%=Html.escape(c)%></option><% } %></select></div><div class="field"><label>Problem description</label><textarea name="description" minlength="12" required placeholder="Symptoms, when they started, and what you tried"></textarea></div><div class="field"><label>Urgency</label><select name="urgency"><option>Within 24 hours</option><option>This week</option><option>Flexible</option></select></div><div class="field"><label>Maximum budget (INR)</label><input name="budget" type="number" min="1" step="0.01" required></div><button>Publish request</button></form></section><% } %><section class="card"><h2>Recent activity</h2><ul class="activity"><% List<String> activity=(List<String>)request.getAttribute("activity"); if(activity.isEmpty()){ %><li>No new activity in this session.</li><% } for(String item:activity){ %><li><%=Html.escape(item)%></li><% } %></ul></section></aside></div></div></main></div></body></html>
