<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.resolvebid.web.Html" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · ResolveBid</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><main class="auth-page"><section class="auth-story"><div class="brand">ResolveBid</div><div><div class="eyebrow">Service marketplace</div><h1>Turn a problem into the right solution.</h1><p>Describe what is wrong. Compare provider proposals by price, speed, and warranty. Book with a clear record of every decision.</p><div class="proof"><div><strong>Secure</strong><span>PBKDF2 passwords</span></div><div><strong>Clear</strong><span>Comparable bids</span></div><div><strong>Ready</strong><span>MySQL deployment</span></div></div></div><small>Java 21 · Servlets · JSP · JDBC</small></section>
<section class="auth-panel"><div class="auth-card"><div class="eyebrow">Welcome back</div><h2>Sign in</h2><p class="lede">Access your private ResolveBid workspace.</p><% if(request.getAttribute("error")!=null){ %><div class="alert error" role="alert"><%=Html.escape(request.getAttribute("error"))%></div><% } %><% if(request.getAttribute("flashMessage")!=null){ %><div class="alert <%=Html.escape(request.getAttribute("flashKind"))%>"><%=Html.escape(request.getAttribute("flashMessage"))%></div><% } %>
<form method="post" action="${pageContext.request.contextPath}/login"><input type="hidden" name="csrf" value="<%=Html.escape(request.getAttribute("csrf"))%>"><div class="field"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required autofocus maxlength="32"></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div><button type="submit">Sign in securely</button></form><p class="auth-footer">New here? <a href="${pageContext.request.contextPath}/register">Create an account</a></p></div></section></main></body></html>
