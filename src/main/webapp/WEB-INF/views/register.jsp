<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.resolvebid.web.Html" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account · ResolveBid</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><main class="auth-page"><section class="auth-story"><div class="brand">ResolveBid</div><div><div class="eyebrow">Join the marketplace</div><h1>Choose your side of the solution.</h1><p>Customers publish problems. Providers submit transparent proposals. Every role sees only the actions it is authorized to perform.</p></div><small>Secure sessions · CSRF protection · Role permissions</small></section><section class="auth-panel"><div class="auth-card"><div class="eyebrow">Create account</div><h2>Get started</h2><p class="lede">Your password is salted and hashed before storage.</p><% if(request.getAttribute("error")!=null){ %><div class="alert error" role="alert"><%=Html.escape(request.getAttribute("error"))%></div><% } %><form method="post" action="${pageContext.request.contextPath}/register"><input type="hidden" name="csrf" value="<%=Html.escape(request.getAttribute("csrf"))%>"><div class="field"><label for="displayName">Display name</label><input id="displayName" name="displayName" required maxlength="100" autocomplete="name"></div><div class="field"><label for="username">Username</label><input id="username" name="username" required maxlength="32" autocomplete="username"><p class="hint">3–32 letters, numbers, dots, hyphens, or underscores.</p></div><div class="field"><label for="role">I want to</label><select id="role" name="role"><option value="CUSTOMER">Post problems as a customer</option><option value="PROVIDER">Solve problems as a provider</option></select></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" required autocomplete="new-password"><p class="hint">12+ characters with uppercase, lowercase, number, and symbol.</p></div><button type="submit">Create secure account</button></form><p class="auth-footer">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></div></section></main></body></html>
